#!/usr/bin/env python3
"""nonGitLine: keep `//!!` note lines on disk but out of git commits.

Subcommands:
  install | uninstall        set up / remove the filter and hooks in the current repo
  on | off                   switch the filter on/off (notes are kept; the hooks keep guarding)
  ide on | ide off           switch the editor helpers on/off (diff textconv + refresh)
  status                     show what is switched on
  refresh [file...]          drop note-only files from the "changed" list (no-op unless `ide on`)
  textconv <file>            print a version with the saved notes put back (for editor diffs)
  process                    git long-running filter (what install configures)
  clean <path>               stdin -> stdout without notes; notes saved (same as the filter, for one file)
  smudge <path>              stdin -> stdout with saved notes put back
  check pre-commit|pre-push  hook entry points
  orphans [--drop <path>]    list (or forget) notes that could not be put back
"""
import difflib
import functools
import json
import os
import re
import shlex
import subprocess
import sys
import time
import traceback

MARKER = '//!!'
EXTS = ('.java', '.cs')
FILTER = 'nongitline'
HOOK_TAG = '# nongitline-hook'
ATTR_BEGIN, ATTR_END = '# >>> nongitline', '# <<< nongitline'
IDE_BEGIN, IDE_END = '# >>> nongitline-ide', '# <<< nongitline-ide'
BACKUPS_KEPT = 20
TYPO = re.compile(r'[ \t]+!!')


# ---------------------------------------------------------------- lexer

def split_lines(text):
    """Split keeping line endings; unlike str.splitlines, only '\\n' breaks a line."""
    parts = text.split('\n')
    lines = [p + '\n' for p in parts[:-1]]
    if parts[-1]:
        lines.append(parts[-1])
    return lines


def close_string(line, i, kind, delim, interp=False):
    """Scan from i inside a string literal. Return the index just past the
    closing delimiter, or -1 if the string runs past the end of the line.
    kind: 'esc' (backslash escapes), 'verb' (C# @"", "" escapes), 'raw' (none)."""
    n = len(line)
    while i < n:
        c = line[i]
        if kind == 'esc' and c == '\\':
            i += 2
            continue
        if kind == 'verb' and line.startswith('""', i):
            i += 2
            continue
        if interp and c == '{':
            if line.startswith('{{', i):
                i += 2
                continue
            # ponytail: skips the hole by brace depth only; a string holding '}' inside a hole confuses it
            depth = 0
            while i < n:
                depth += {'{': 1, '}': -1}.get(line[i], 0)
                i += 1
                if depth == 0:
                    break
            continue
        if line.startswith(delim, i):
            return i + len(delim)
        i += 1
    return -1


def line_kinds(lines, cs):
    """Classify each line: 'note' (whole-line marker in code), 'trailing'
    (marker comment after code), 'typo' (e.g. `// !!`) or None.
    A marker line inside a block comment is a note unless it also closes the
    comment; inside a multi-line string it is data, never a note."""
    kinds = []
    state = None  # None = code, '*/' = block comment, else (kind, delim, interp) of an open string
    for line in lines:
        in_comment = state == '*/' and '*/' not in line
        if (state is None or in_comment) and line.lstrip(' \t').startswith(MARKER):
            kinds.append('note')
            continue
        kind, i, n, at_start = None, 0, len(line), True
        while i < n:
            if state == '*/':
                j = line.find('*/', i)
                if j < 0:
                    break
                state, i, at_start = None, j + 2, False
                continue
            if state is not None:
                j = close_string(line, i, *state)
                if j < 0:
                    break
                state, i, at_start = None, j, False
                continue
            c = line[i]
            if c in ' \t\r\n':
                i += 1
            elif line.startswith('//', i):
                body = line[i + 2:]
                if body.startswith('!!'):
                    kind = 'trailing'
                elif at_start and TYPO.match(body):
                    kind = 'typo'
                break
            elif line.startswith('/*', i):
                state, i = '*/', i + 2
            elif c == "'":
                j = close_string(line, i + 1, 'esc', "'")
                i, at_start = (n if j < 0 else j), False
            elif c == '"':
                state, i = open_string(line, i, cs)
                at_start = False
            else:
                i, at_start = i + 1, False
        kinds.append(kind)
        if state is not None and state != '*/' and state[0] == 'esc' and state[1] == '"':
            state = None  # an unterminated one-line string ends with the line
    return kinds


def open_string(line, i, cs):
    """At a '"' in code: return (state, index). state is None if the string
    closed on this line, else the open string to carry to the next line."""
    q = len(line[i:]) - len(line[i:].lstrip('"'))
    prefix = ''
    k = i
    while cs and k > 0 and line[k - 1] in '@$':
        k -= 1
        prefix = line[k] + prefix
    verbatim, interp = '@' in prefix, '$' in prefix
    if q >= 3 and not verbatim:
        delim = '"' * q if cs else '"""'
        state = ('raw', delim, False) if cs else ('esc', '"""', False)
        i += len(delim)
    elif q == 2:
        return None, i + 2  # empty string
    else:
        state = ('verb', '"', interp) if verbatim else ('esc', '"', interp)
        i += 1
    j = close_string(line, i, *state)
    return (state, len(line)) if j < 0 else (None, j)


def split_notes(text, cs):
    """Return (bom, clean lines, blocks). A block is a run of note lines:
    {'at': index of the clean line it sits above, 'lines': [...]}."""
    bom = '﻿' if text.startswith('﻿') else ''
    lines = split_lines(text[len(bom):])
    clean, blocks = [], []
    for line, kind in zip(lines, line_kinds(lines, cs)):
        if kind != 'note':
            clean.append(line)
        elif blocks and blocks[-1]['at'] == len(clean):
            blocks[-1]['lines'].append(line)
        else:
            blocks.append({'at': len(clean), 'lines': [line]})
    return bom, clean, blocks


def strip_notes(text, cs):
    bom, clean, _ = split_notes(text, cs)
    return bom + ''.join(clean)


def place(store, new):
    """Put the stored note blocks (and earlier orphans) into `new` clean lines.
    Return (lines with notes, blocks, orphans).

    A block goes above its old next line if that line survived unchanged
    (difflib), else below its old previous line. Failing both, and for
    orphans, a unique exact match of either neighbour is accepted. Anything
    else stays an orphan: never guessed into place, never dropped."""
    base = store['base']
    pos = {}
    for tag, i1, i2, j1, _ in difflib.SequenceMatcher(None, base, new, autojunk=False).get_opcodes():
        if tag == 'equal':
            pos.update((i1 + k, j1 + k) for k in range(i2 - i1))
    todo = []  # (new index or None, orphan record)
    for b in store['blocks']:
        at = b['at']
        j = pos.get(at)
        if j is None and at - 1 in pos:
            j = pos[at - 1] + 1
        if j is None and not base:
            j = 0
        todo.append((j, {'lines': b['lines'],
                         'before': base[at - 1] if at else None,
                         'after': base[at] if at < len(base) else None}))
    todo += [(None, o) for o in store['orphans']]
    inserts, orphans = {}, []
    for j, o in todo:
        if j is None:
            j = find_unique(new, o)
        if j is None or (j and not new[j - 1].endswith('\n')):  # no line to hang it under without touching code
            orphans.append(o)
        else:
            inserts.setdefault(j, []).append(o['lines'])
    out, blocks = [], []
    for j in range(len(new) + 1):
        for lines in inserts.get(j, []):
            if j < len(new) and not lines[-1].endswith('\n'):  # was the file's last line
                lines = lines[:-1] + [lines[-1] + ('\r\n' if new[j].endswith('\r\n') else '\n')]
            if blocks and blocks[-1]['at'] == j:
                blocks[-1]['lines'] += lines
            else:
                blocks.append({'at': j, 'lines': list(lines)})
            out += lines
        if j < len(new):
            out.append(new[j])
    return out, blocks, orphans


def find_unique(lines, orphan):
    for anchor, shift in ((orphan['after'], 0), (orphan['before'], 1)):
        if anchor is not None and lines.count(anchor) == 1:
            return lines.index(anchor) + shift
    return None


def decode(data):
    """Bytes -> str, or None for content we must not touch (binary, non UTF-8)."""
    if b'\0' in data:
        return None
    try:
        return data.decode('utf-8')
    except UnicodeDecodeError:
        return None


# ---------------------------------------------------------------- git helpers

def git(*args, data=None):
    return subprocess.run(('git',) + args, input=data, stdout=subprocess.PIPE, check=True).stdout


@functools.lru_cache(maxsize=None)
def git_dir():
    return os.path.abspath(git('rev-parse', '--git-dir').decode().strip())


def store_file(path):
    return os.path.join(git_dir(), FILTER, 'notes', path + '.json')


def load_store(path):
    try:
        with open(store_file(path)) as f:
            return json.load(f)
    except FileNotFoundError:
        return None


def save_store(path, store):
    """{'base': clean lines last seen, 'blocks': [...], 'orphans': [...]}; written atomically."""
    p = store_file(path)
    if not store['blocks'] and not store['orphans']:
        if os.path.exists(p):
            os.remove(p)
        return
    os.makedirs(os.path.dirname(p), exist_ok=True)
    with open(p + '.tmp', 'w') as f:
        json.dump(store, f)
    os.replace(p + '.tmp', p)


def backup(path, data):
    """Keep the last BACKUPS_KEPT note-bearing versions of a file under .git/nongitline/backup."""
    d = os.path.join(git_dir(), FILTER, 'backup', path)
    os.makedirs(d, exist_ok=True)
    names = sorted(os.listdir(d))
    if names:
        with open(os.path.join(d, names[-1]), 'rb') as f:
            if f.read() == data:
                return
    with open(os.path.join(d, time.strftime('%Y%m%d-%H%M%S-') + str(time.time_ns())), 'wb') as f:
        f.write(data)
    for old in names[:len(names) + 1 - BACKUPS_KEPT]:
        os.remove(os.path.join(d, old))


# ---------------------------------------------------------------- filter

def clean(path, data):
    has_marker = MARKER.encode() in data
    store = load_store(path)
    text = decode(data) if has_marker or store else None
    if text is None:
        if has_marker:
            print(f'nongitline: {path} is not UTF-8 text, left unchanged', file=sys.stderr)
        return data
    bom, lines, blocks = split_notes(text, path.endswith('.cs'))
    # A failure here must fail `git add`: a note we cannot remember is a note smudge cannot restore.
    save_store(path, {'base': lines, 'blocks': blocks, 'orphans': store['orphans'] if store else []})
    if blocks:
        try:
            backup(path, data)
        except OSError as e:  # the backup is a second safety net; never block git on it
            print(f'nongitline: backup of {path} failed: {e}', file=sys.stderr)
    return (bom + ''.join(lines)).encode('utf-8')


def smudge(path, data):
    store = load_store(path)
    text = decode(data) if store else None
    if text is None:
        return data
    bom = '﻿' if text.startswith('﻿') else ''
    new = split_lines(text[len(bom):])
    out, blocks, orphans = place(store, new)
    save_store(path, {'base': new, 'blocks': blocks, 'orphans': orphans})
    if orphans:
        print(f'nongitline: {len(orphans)} note block(s) in {path} could not be put back; '
              f'they are kept, see: nongitline orphans', file=sys.stderr)
    return (bom + ''.join(out)).encode('utf-8')


# git's long-running filter protocol (man gitattributes, "Long Running Filter Process"):
# one process serves every file of a git command instead of one python start per file.

PKT_MAX = 65516


def read_pkts(f):
    """Read pkt-lines up to the next flush packet. EOFError when git hangs up."""
    out = []
    while True:
        head = f.read(4)
        if len(head) < 4:
            raise EOFError
        n = int(head, 16)
        if n == 0:
            return out
        out.append(f.read(n - 4))


def write_pkts(f, *items):
    """Write each item as a pkt-line (None = flush packet)."""
    for item in items:
        f.write(b'0000' if item is None else b'%04x' % (len(item) + 4) + item)


def cmd_process():
    i, o = sys.stdin.buffer, sys.stdout.buffer
    if read_pkts(i) != [b'git-filter-client\n', b'version=2\n']:
        print('nongitline: unexpected filter handshake', file=sys.stderr)
        return 1
    write_pkts(o, b'git-filter-server\n', b'version=2\n', None)
    o.flush()  # git waits for this before sending capabilities
    caps = read_pkts(i)
    write_pkts(o, *[c for c in (b'capability=clean\n', b'capability=smudge\n') if c in caps], None)
    o.flush()
    while True:
        try:
            meta = dict(l.rstrip(b'\n').decode('utf-8', 'surrogateescape').split('=', 1) for l in read_pkts(i))
            data = b''.join(read_pkts(i))
        except EOFError:
            return 0
        try:
            out = {'clean': clean, 'smudge': smudge}[meta['command']](meta['pathname'], data)
        except Exception:  # report this file as failed; `required` makes git stop instead of losing notes
            traceback.print_exc()
            write_pkts(o, b'status=error\n', None)
        else:
            write_pkts(o, b'status=success\n', None,
                       *[out[k:k + PKT_MAX] for k in range(0, len(out), PKT_MAX)], None, None)
        o.flush()


# ---------------------------------------------------------------- editor helpers
# Editors (VS Code: `git show --textconv <ref>:<path>`) diff your file against the committed
# version, where notes don't exist, so every note shows as an added line. With `ide on`,
# a textconv driver hands them that version with the saved notes put back.

def with_notes(arg, data):
    """`data` (a version of the file named `arg`) with the saved notes put back. Read-only."""
    text = decode(data)
    if text is None:
        return data
    bom, lines, _ = split_notes(text, arg.endswith('.cs'))  # a working-tree file already has notes
    if os.path.isabs(arg):  # git passes a temp copy (…/git-blob-XXXX/<name>) for committed versions
        store = guess_store(os.path.basename(arg), lines)
    else:
        store = load_store(arg)
    if not store:
        return data
    out, _, _ = place(store, lines)
    return (bom + ''.join(out)).encode('utf-8')


def guess_store(name, lines):
    """The note store of a file called `name`; the most similar one if several share the name."""
    root = os.path.join(git_dir(), FILTER, 'notes')
    stores = []
    for dirpath, _, names in os.walk(root):
        if name + '.json' in names:
            with open(os.path.join(dirpath, name + '.json')) as f:
                stores.append(json.load(f))
    if len(stores) > 1:
        # ponytail: a full diff per candidate; fine for the handful of files sharing a name
        return max(stores, key=lambda s: difflib.SequenceMatcher(None, s['base'], lines, autojunk=False).ratio())
    return stores[0] if stores else None


def cmd_textconv(arg):
    with open(arg, 'rb') as f:
        sys.stdout.buffer.write(with_notes(arg, f.read()))
    return 0


def cmd_refresh(files):
    """Git marks a file modified as soon as its size changes, without reading it, so adding or
    removing a note lists the file as changed with an empty diff. For each such file whose
    clean content equals the index, re-register the same blob: git then compares by content."""
    if files:
        os.chdir(os.path.dirname(os.path.abspath(files[0])))
    if subprocess.run(['git', 'rev-parse'], stderr=subprocess.DEVNULL).returncode or not is_on('ide'):
        return 0  # not a repo, or switched off: an editor hook may call this anywhere
    top = os.path.realpath(git('rev-parse', '--show-toplevel').decode().strip())
    os.chdir(top)
    paths = [os.path.relpath(os.path.realpath(f), top) for f in files] if files else \
        git('ls-files', '-m', '-z').decode().split('\0')
    same = []
    for path in paths:
        if not path.endswith(EXTS) or not os.path.isfile(path) or path.startswith('..'):
            continue
        entry = git('ls-files', '-s', '-z', '--', path).decode().split('\t')[0].split()
        if len(entry) != 3 or entry[2] != '0':
            continue  # untracked or in a merge conflict
        if git('hash-object', '--', path).decode().strip() == entry[1]:
            same.append(path)
    forget_stat(same)
    return 0


def forget_stat(paths):
    """Re-register the index entries of `paths` with the same blob but no stat data, so git
    compares their content next time instead of trusting size and mtime. Nothing is staged."""
    if paths:
        entries = git('ls-files', '-s', '-z', '--', *paths)
        git('update-index', '-z', '--index-info', data=entries)
        subprocess.run(['git', 'update-index', '-q', '--refresh'], stdout=subprocess.DEVNULL)


def cmd_orphans(argv):
    if argv[:1] == ['--drop'] and len(argv) == 2:
        store = load_store(argv[1])
        if store:
            store['orphans'] = []
            save_store(argv[1], store)
        print(f'nongitline: orphans of {argv[1]} dropped')
        return 0
    root = os.path.join(git_dir(), FILTER, 'notes')
    top = git('rev-parse', '--show-toplevel').decode().strip()
    for dirpath, _, names in os.walk(root):
        for name in sorted(n for n in names if n.endswith('.json')):
            path = os.path.relpath(os.path.join(dirpath, name), root)[:-len('.json')]
            store = load_store(path)
            if not os.path.exists(os.path.join(top, path)) and store['blocks']:
                print(f'{path}: file not in the working tree; {len(store["blocks"])} note block(s) '
                      f'come back when it does')
            for o in store['orphans']:
                print(f'{path}: was between')
                print(f'    {(o["before"] or "<start of file>").rstrip()}')
                print(f'    {(o["after"] or "<end of file>").rstrip()}')
                print(''.join('  | ' + l.rstrip('\r\n') + '\n' for l in o['lines']), end='')
    return 0


# ---------------------------------------------------------------- checks

def problems_in(path, data, typos):
    text = decode(data)
    if text is None:
        return []
    lines = split_lines(text.lstrip('﻿'))
    found = []
    for no, (line, kind) in enumerate(zip(lines, line_kinds(lines, path.endswith('.cs'))), 1):
        if line.lstrip(' \t').startswith(MARKER):
            why = 'note line would be committed'  # filter off, or the lexer thinks it is inside a string
        elif kind == 'trailing':
            why = 'trailing //!! note (only whole-line notes are removed)'
        elif kind == 'typo' and typos:
            why = 'looks like a mistyped //!! marker'
        else:
            continue
        found.append(f'  {path}:{no}: {why}\n      {line.strip()}')
    return found


def cmd_check_pre_commit():
    out = git('diff', '--cached', '--name-only', '--diff-filter=ACM', '-z').decode()
    found = []
    for path in filter(None, out.split('\0')):
        if path.endswith(EXTS):
            found += problems_in(path, git('cat-file', 'blob', ':' + path), typos=True)
    if found:
        print('nongitline: commit blocked (line numbers are in the staged version):', *found,
              'Fix the lines, or commit with --no-verify if they are intended.', sep='\n', file=sys.stderr)
        return 1
    return 0


def cmd_check_pre_push():
    blobs = {}  # sha -> (commit, path)
    for line in sys.stdin:
        local_ref, local_sha, remote_ref, remote_sha = line.split()
        if set(local_sha) == {'0'}:
            continue  # branch deletion
        rng = [local_sha, '--not', '--remotes']
        if set(remote_sha) != {'0'} and subprocess.run(['git', 'cat-file', '-e', remote_sha]).returncode == 0:
            rng.append(remote_sha)
        for commit in git('rev-list', *rng).decode().split():
            out = git('diff-tree', '-r', '--root', '--no-commit-id', '--no-renames',
                      '--diff-filter=ACM', '-z', commit).decode().split('\0')
            for meta, path in zip(out[0::2], out[1::2]):
                if path.endswith(EXTS):
                    blobs.setdefault(meta.split()[3], (commit[:10], path))
    found = []
    for sha, (commit, path) in blobs.items():
        found += problems_in(f'{commit}:{path}', git('cat-file', 'blob', sha), typos=False)
    if found:
        print('nongitline: push blocked, notes reached these commits:', *found,
              'Rewrite those commits (amend/rebase), or push with --no-verify if intended.',
              sep='\n', file=sys.stderr)
        return 1
    return 0


# ---------------------------------------------------------------- install

def hook_paths():
    d = os.path.abspath(git('rev-parse', '--git-path', 'hooks').decode().strip())
    return {name: os.path.join(d, name) for name in ('pre-commit', 'pre-push')}


ME = shlex.quote(os.path.abspath(__file__))


def set_attr_block(begin, end, lines):
    """Replace our block in .git/info/attributes with `lines` (None removes it)."""
    attrs = os.path.join(git_dir(), 'info', 'attributes')
    os.makedirs(os.path.dirname(attrs), exist_ok=True)
    text = open(attrs).read() if os.path.exists(attrs) else ''
    text = re.sub(f'^{re.escape(begin)}$.*?^{re.escape(end)}$\n?', '', text, flags=re.S | re.M)
    if lines:
        text += ('\n' if text and not text.endswith('\n') else '') + '\n'.join([begin] + lines + [end]) + '\n'
    with open(attrs, 'w') as f:
        f.write(text)


def is_on(what):
    key = {'filter': f'filter.{FILTER}.process', 'ide': f'diff.{FILTER}.textconv'}[what]
    return subprocess.run(['git', 'config', '--get', key], stdout=subprocess.DEVNULL).returncode == 0


def filter_on():
    git('config', f'filter.{FILTER}.process', f'{ME} process')
    git('config', f'filter.{FILTER}.required', 'true')


def remove_config_section(name):
    subprocess.run(['git', 'config', '--remove-section', name], stderr=subprocess.DEVNULL)


def cmd_install():
    hooks = hook_paths()
    foreign = [p for p in hooks.values() if os.path.exists(p) and HOOK_TAG not in open(p).read()]
    if foreign:
        print('nongitline: these hooks already exist and were not written by nongitline:', *foreign,
              f'Add this line to each, then re-run install:  {os.path.abspath(__file__)} check <hook-name> "$@"',
              sep='\n', file=sys.stderr)
        return 1
    filter_on()
    set_attr_block(ATTR_BEGIN, ATTR_END, [f'*{e} filter={FILTER}' for e in EXTS])
    os.makedirs(os.path.dirname(hooks['pre-commit']), exist_ok=True)
    for name, p in hooks.items():
        with open(p, 'w') as f:
            f.write(f'#!/bin/sh\n{HOOK_TAG}\nexec {ME} check {name} "$@"\n')
        os.chmod(p, 0o755)
    print('nongitline: installed. //!! lines in *.java and *.cs stay out of commits.')
    return 0


def cmd_uninstall():
    remove_config_section(f'filter.{FILTER}')
    remove_config_section(f'diff.{FILTER}')
    set_attr_block(ATTR_BEGIN, ATTR_END, None)
    set_attr_block(IDE_BEGIN, IDE_END, None)
    for p in hook_paths().values():
        if os.path.exists(p) and HOOK_TAG in open(p).read():
            os.remove(p)
    print('nongitline: removed. Note lines will now show up as changes and can be committed.')
    return 0


def cmd_switch(on):
    """Filter on/off. Off leaves notes, the note store and the hooks in place, so a note
    can't be committed by accident while the filter is off: the hooks still block it."""
    if on:
        filter_on()
    else:
        remove_config_section(f'filter.{FILTER}')
    # git trusts the cached stat of unchanged files and would not notice the switch
    forget_stat([p for p in git('ls-files', '-z').decode().split('\0') if p.endswith(EXTS)])
    if on:
        print('nongitline: filter on. //!! lines stay out of commits.\n'
              'Files staged while it was off still hold their notes: `git add` them again.')
    else:
        print('nongitline: filter off. Notes show up as changes; the hooks still block committing them.\n'
              'Turn it back on with: nongitline on')
    return 0


def cmd_ide(on):
    if on:
        git('config', f'diff.{FILTER}.textconv', f'{ME} textconv')
        set_attr_block(IDE_BEGIN, IDE_END, [f'*{e} diff={FILTER}' for e in EXTS])
        print('nongitline: editor helpers on. Diffs against committed versions include your notes,\n'
              'and `nongitline refresh` clears note-only files from the changed list.')
    else:
        remove_config_section(f'diff.{FILTER}')
        set_attr_block(IDE_BEGIN, IDE_END, None)
        print('nongitline: editor helpers off.')
    return 0


def cmd_status():
    hooks = [n for n, p in hook_paths().items() if os.path.exists(p) and HOOK_TAG in open(p).read()]
    print(f'filter : {"on" if is_on("filter") else "off"}\n'
          f'hooks  : {", ".join(hooks) or "none"}\n'
          f'ide    : {"on" if is_on("ide") else "off"}')
    return 0


def main(argv):
    if argv == ['process']:
        return cmd_process()
    if argv[:1] in (['clean'], ['smudge']) and len(argv) == 2:
        run = clean if argv[0] == 'clean' else smudge
        sys.stdout.buffer.write(run(argv[1], sys.stdin.buffer.read()))
        return 0
    if argv[:1] == ['orphans']:
        return cmd_orphans(argv[1:])
    if argv == ['check', 'pre-commit']:
        return cmd_check_pre_commit()
    if argv[:2] == ['check', 'pre-push']:
        return cmd_check_pre_push()
    if argv == ['install']:
        return cmd_install()
    if argv == ['uninstall']:
        return cmd_uninstall()
    if argv in (['on'], ['off']):
        return cmd_switch(argv[0] == 'on')
    if argv in (['ide', 'on'], ['ide', 'off']):
        return cmd_ide(argv[1] == 'on')
    if argv == ['status']:
        return cmd_status()
    if argv[:1] == ['refresh']:
        return cmd_refresh(argv[1:])
    if argv[:1] == ['textconv'] and len(argv) == 2:
        return cmd_textconv(argv[1])
    print(__doc__, file=sys.stderr)
    return 2


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]) or 0)
